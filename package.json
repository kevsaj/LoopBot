{
  "name": "loopbot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo --emptyOutDir",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check-levels": "vitest run src/levels",
    "daily:bank": "esbuild scripts/make-daily.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/make-daily.mjs --log-level=warning && node node_modules/.cache/make-daily.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "android:bundle": "npm run cap:sync && node scripts/gradle.mjs bundleRelease",
    "android:apk": "npm run cap:sync && node scripts/gradle.mjs assembleDebug",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
